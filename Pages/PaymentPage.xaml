<Page x:Class="KindergartenCRUD.Pages.PaymentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Record Payment">
    <Grid Margin="20">
        <StackPanel MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="LangButton" Content="العربية" HorizontalAlignment="Right"
                    Padding="6,2" Margin="0,0,0,14" Click="LangButton_Click"/>

            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
            <TextBlock x:Name="FeeText" Foreground="Gray" Margin="0,0,0,18"/>

            <TextBlock x:Name="MonthLabel" Text="Month"/>
            <ComboBox x:Name="MonthBox" Margin="0,2,0,10" Padding="4" SelectionChanged="MonthBox_SelectionChanged"/>

            <TextBlock x:Name="AmountLabel" Text="Amount"/>
            <TextBox x:Name="AmountBox" Padding="4" Margin="0,2,0,16"/>

            <UniformGrid Columns="2" Rows="1">
                <Button x:Name="SaveButton" Content="Save" Padding="8" Margin="2" Click="SaveButton_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" Padding="8" Margin="2" Click="CancelButton_Click"/>
            </UniformGrid>

            <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>
