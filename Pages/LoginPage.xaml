<Page x:Class="KindergartenCRUD.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Login"
      Background="#F4F6F8">
    <Grid>
        <Border Width="360" Height="340" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" CornerRadius="8" Padding="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">
                <Button x:Name="LangButton" Content="العربية" HorizontalAlignment="Right"
                        Padding="6,2" Margin="0,0,0,10" Click="LangButton_Click"/>

                <TextBlock x:Name="TitleText" Text="Kindergarten Manager" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock x:Name="UserLabel" Text="Username"/>
                <TextBox x:Name="UsernameBox" Padding="4" Margin="0,2,0,12"/>

                <TextBlock x:Name="PassLabel" Text="Password"/>
                <PasswordBox x:Name="PasswordBox" Padding="4" Margin="0,2,0,16"/>

                <Button x:Name="LoginButton" Content="Login" Padding="6" Click="LoginButton_Click"/>

                <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,12,0,0"
                           TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
